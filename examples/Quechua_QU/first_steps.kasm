; ==========================================
; First Steps in Quechua / Runa Simi (qu)
; MultiLang-ASM Kids
; ==========================================

astay box 10       ; Put 10 candies in the box
yapay box 5        ; Get 5 more candies (15)
qichuy box 2        ; Eat 2 candies (13 left!)
llanu_waqyay box         ; Show the final candy count!
