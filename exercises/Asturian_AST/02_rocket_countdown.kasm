; ==========================================
; CHALLENGE 2: Rocket Launch Countdown
; Language: Asturian / Asturianu (ast)
; ==========================================
; Count down from 5 to 1, then launch!

mover counter 5

launch_loop:
llamada_sistema counter
restar counter 1
comparar counter 0
if_different launch_loop

; Blastoff!
mover box 999
llamada_sistema box
